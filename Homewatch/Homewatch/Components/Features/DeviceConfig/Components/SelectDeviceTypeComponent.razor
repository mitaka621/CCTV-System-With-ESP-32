@inject IDeviceTypeService _deviceTypeService
@inject IDeviceTypeIconStorageService _deviceTypeIconStorageService

<MudStack Spacing="3" Style="flex: 1 1 auto; min-height: 0;">
    <MudStack Row="true" Spacing="6" Justify="Justify.Center">
        <MudText Class="mt-1" Typo="Typo.h4">Select the Device Type</MudText>
        <MudSpacer />
        <MudSpacer />
        <MudSpacer />
        <MudTextField T="string"
                      Value="_searchPhrase"
                      ValueChanged="OnSearchPhraseChanged"
                      Label="@GetSearchLabel()"
                      Variant="Variant.Filled"
                      Clearable="true"
                      Adornment="Adornment.End"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      AdornmentColor="Color.Primary"
                      Immediate="true"
                      DebounceInterval="200" />
    </MudStack>
    <MudPaper Class="pa-4"
              Outlined="true">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Info" />
            <MudText>
                If you are not seeing the device type that you want to add,
                you can create a new device configuration from the settings.
            </MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Settings"
                       Color="Color.Secondary"
                       Href="/system/settings/deviceTypes">
                Go To Settings
            </MudButton>
        </MudStack>
    </MudPaper>

    @if (IsShowingCategories())
    {
        <div class="device-type-picker-scroll">
            <div class="device-category-grid">
                @foreach (var category in Enum.GetValues<DeviceTypeCategories>())
                {
                    <MudButton Variant="Variant.Outlined"
                               Color="@DeviceCategoryAppearance.GetColor(category)"
                               Class="device-category-button"
                               OnClick="() => SelectCategory(category)">
                        <MudStack AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@DeviceCategoryAppearance.GetIcon(category)" Class="device-category-icon" />
                            <MudText Typo="Typo.h6">@MiscUtilities.GetDisplayNameAttributeValue(category)</MudText>
                            <MudText Typo="Typo.caption">@GetDeviceTypeCountText(GetDeviceTypeCount(category))</MudText>
                        </MudStack>
                    </MudButton>
                }
            </div>
        </div>
    }
    else
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudButton Variant="Variant.Text"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="ReturnToCategories">
                Categories
            </MudButton>
            <MudDivider Vertical="true" FlexItem="true" />
            @if (_selectedCategory.HasValue)
            {
                <MudIcon Icon="@DeviceCategoryAppearance.GetIcon(_selectedCategory.Value)"
                         Color="@DeviceCategoryAppearance.GetColor(_selectedCategory.Value)" />
                <MudText Typo="Typo.h6">@MiscUtilities.GetDisplayNameAttributeValue(_selectedCategory.Value)</MudText>
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.Search" Color="Color.Primary" />
                <MudText Typo="Typo.h6">All Categories</MudText>
            }
            <MudSpacer />
            @if (_filteredDeviceTypeCount.HasValue)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@GetDeviceTypeCountText(_filteredDeviceTypeCount.Value)</MudText>
            }
        </MudStack>

        <div class="device-type-picker-scroll">
            <Virtualize @ref="_virtualize"
                        TItem="DeviceTypeDisplayModel"
                        ItemsProvider="LoadDeviceTypesAsync"
                        Context="deviceType"
                        ItemSize="134"
                        OverscanCount="3">
                <ItemContent>
                    <MudPaper Class="@GetRowClass(deviceType)" Outlined="true" Elevation="0">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4" Class="device-type-row-content">
                            <MudImage Src="@deviceType.GetIconUrl(_deviceTypeIconStorageService)"
                                      Alt="@deviceType.Name"
                                      Height="96"
                                      Width="96"
                                      ObjectFit="ObjectFit.Cover"
                                      Class="device-type-image" />
                            <MudStack Justify="Justify.Center" AlignItems="AlignItems.Start" Spacing="2" Class="device-type-name-column">
                                <MudText Typo="Typo.h6" Class="device-type-name">@deviceType.Name</MudText>
                                <DeviceCategoryChip Category="deviceType.DeviceCategory" Class="ma-0" />
                            </MudStack>
                            <MudDivider Vertical="true" FlexItem="true" Class="device-type-separator" />
                            @if (string.IsNullOrWhiteSpace(deviceType.Description))
                            {
                                <MudText Typo="Typo.body2" Class="device-type-description mud-text-disabled">No description provided.</MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Class="device-type-description mud-text-secondary">@deviceType.Description</MudText>
                            }
                            <MudFab Color="@(model.DeviceTypeId == deviceType.Id ? Color.Success : Color.Primary)"
                                    StartIcon="@Icons.Material.Filled.Check"
                                    OnClick="() => SelectDeviceType(deviceType.Id, deviceType.DeviceCategory)" />
                        </MudStack>
                    </MudPaper>
                </ItemContent>
                <Placeholder>
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle"
                                 Height="122px"
                                 Class="mb-3" />
                </Placeholder>
                <EmptyContent>
                    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="device-type-empty-state">
                        <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Class="mud-text-secondary" />
                        <MudText Class="mud-text-secondary">No device types found.</MudText>
                    </MudStack>
                </EmptyContent>
            </Virtualize>
        </div>
    }
</MudStack>

@code {
    [Parameter, EditorRequired]
    public PreprovisionDeviceModel model { get; set; } = default!;

    [Parameter, EditorRequired]
    public EventCallback ModelChanged { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _deviceTypeCountsByCategory = await _deviceTypeService.GetDeviceTypeCountsByCategoryAsync();

        if (model.DeviceTypeId != default)
        {
            _selectedCategory = model.DeviceCategory;
        }
    }

    private Virtualize<DeviceTypeDisplayModel>? _virtualize;

    private Dictionary<DeviceTypeCategories, int> _deviceTypeCountsByCategory = new();

    private int? _filteredDeviceTypeCount;

    private DeviceTypeCategories? _selectedCategory;

    private string _searchPhrase = string.Empty;

    private bool IsShowingCategories()
    {
        return !_selectedCategory.HasValue && string.IsNullOrWhiteSpace(_searchPhrase);
    }

    private async Task OnSearchPhraseChanged(string? value)
    {
        var wasShowingDeviceTypes = !IsShowingCategories();

        _searchPhrase = value ?? string.Empty;

        if (wasShowingDeviceTypes && !IsShowingCategories() && _virtualize != null)
        {
            await _virtualize.RefreshDataAsync();
        }
    }

    private void SelectCategory(DeviceTypeCategories category)
    {
        _selectedCategory = category;
        _filteredDeviceTypeCount = null;
    }

    private void ReturnToCategories()
    {
        _selectedCategory = null;
        _searchPhrase = string.Empty;
        _filteredDeviceTypeCount = null;
    }

    private async ValueTask<ItemsProviderResult<DeviceTypeDisplayModel>> LoadDeviceTypesAsync(ItemsProviderRequest request)
    {
        try
        {
            var page = await _deviceTypeService.GetDeviceTypesPageAsync(
                _selectedCategory,
                _searchPhrase,
                request.StartIndex,
                request.Count,
                request.CancellationToken);

            if (_filteredDeviceTypeCount != page.TotalCount)
            {
                _filteredDeviceTypeCount = page.TotalCount;
                StateHasChanged();
            }

            return new ItemsProviderResult<DeviceTypeDisplayModel>(page.Items, page.TotalCount);
        }
        catch (Exception) when (request.CancellationToken.IsCancellationRequested)
        {
            return new ItemsProviderResult<DeviceTypeDisplayModel>(Array.Empty<DeviceTypeDisplayModel>(), 0);
        }
    }

    private async Task SelectDeviceType(Guid deviceTypeId, DeviceTypeCategories variant)
    {
        if (model.DeviceTypeId != deviceTypeId)
        {
            model.DeviceTypeId = deviceTypeId;
            model.DeviceCategory = variant;
        }
        else
        {
            model.DeviceTypeId = default;
            model.DeviceCategory = default;
        }

        await ModelChanged.InvokeAsync();
    }

    private int GetDeviceTypeCount(DeviceTypeCategories category)
    {
        return _deviceTypeCountsByCategory.GetValueOrDefault(category);
    }

    private string GetDeviceTypeCountText(int count)
    {
        return count == 1 ? "1 device type" : $"{count} device types";
    }

    private string GetSearchLabel()
    {
        return _selectedCategory.HasValue
            ? $"Search in {MiscUtilities.GetDisplayNameAttributeValue(_selectedCategory.Value)}"
            : "Search for device types";
    }

    private string GetRowClass(DeviceTypeDisplayModel deviceType)
    {
        return model.DeviceTypeId == deviceType.Id
            ? "device-type-row device-type-row-selected"
            : "device-type-row";
    }
}
