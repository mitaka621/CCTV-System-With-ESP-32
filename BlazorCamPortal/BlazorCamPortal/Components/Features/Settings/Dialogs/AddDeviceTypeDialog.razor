@inject IDeviceTypeService _deviceTypeService
@inject ISnackbar _snackbar
@inject IConfiguration _configuration
@inject IDeviceTypeIconStorageService _deviceTypeIconStorageService

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="_model" ValidationDelay="0">
            <MudGrid>
                <MudItem xs="6">
                     <MudStack Spacing="3" Justify="Justify.Center">
                        
                        <MudTextField @bind-Value="_model.Name"
                                      Label="Name"
                                      Variant="Variant.Outlined"
                                      For="@(() => _model.Name)"
                                      Immediate="true"
                                      Disabled="_isSubmitting" />

                        <MudTextField @bind-Value="_model.Description"
                                      Label="Description (optional)"
                                      Variant="Variant.Outlined"
                                      For="@(() => _model.Description)"
                                      Immediate="true"
                                      Lines="3"
                                      MaxLines="10"
                                      Sizing="InputSizing.Auto"
                                      Disabled="_isSubmitting" />

                        <MudSelect T="DeviceTypeCategories"
                                   Label="Category"
                                   Variant="Variant.Outlined"
                                   @bind-Value="_model.DeviceCategory"
                                   For="@(() => _model.DeviceCategory)"
                                   Disabled="_isSubmitting">
                            @foreach (var category in Enum.GetValues<DeviceTypeCategories>())
                            {
                                <MudSelectItem Value="@category">@category</MudSelectItem>
                            }
                        </MudSelect>
                    </MudStack>
                </MudItem>
                <MudItem xs="6">
                    <MudStack Row="true" Spacing="0" AlignItems="AlignItems.Center">
                        <MudStack Spacing="0">
                            <img style="width:300px; height:300px; object-fit:cover" src="@_previewIconUrl" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary">300x300px</MudText>
                        </MudStack>
                        <MudStack Spacing="0">
                            <img style="width:200px; height:200px; object-fit:cover" src="@_previewIconUrl" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary">200x200px</MudText>
                        </MudStack>
                        <MudStack Spacing="0">
                            <img style="width:50px; height:50px; object-fit:cover" src="@_previewIconUrl" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary">50x50px</MudText>
                        </MudStack>
                    </MudStack> 
                        <div>
                            <MudFileUpload T="IBrowserFile"
                                           Accept="@string.Join(", ", _deviceTypeIconStorageService.AllowedContentTypes)"
                                           FilesChanged="OnFileChanged"
                                           MaximumFileCount="1"
                                           MaxFileSize="@_maxIconSizeBytes"
                                           Disabled="_isSubmitting">
                                <ActivatorContent>
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.UploadFile"
                                               FullWidth="true"
                                               Disabled="_isSubmitting">
                                        @(_model.IconFile is null ? "Upload Icon" : _model.IconFile.Name)
                                    </MudButton>
                                </ActivatorContent>
                            </MudFileUpload>
                            @if (!string.IsNullOrEmpty(_iconError))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Error" Class="mt-1">@_iconError</MudText>
                            }
                        </div>
                </MudItem>
            </MudGrid>

            @if (!string.IsNullOrEmpty(_submitError))
            {
                <MudAlert Severity="Severity.Error" NoIcon="true">@_submitError</MudAlert>
            }

        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_isSubmitting">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="SubmitAsync"
                   Disabled="_isSubmitting">
            @if (_isSubmitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <text>Creating...</text>
            }
            else
            {
                <text>Create</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    public IMudDialogInstance? MudDialog { get; set; }

    private MudForm _form = default!;
    private readonly CreateDeviceTypeModel _model = new();
    private string? _iconError;
    private string? _submitError;
    private bool _isSubmitting;
    private string? _previewIconUrl;

    private long _maxIconSizeBytes;

    protected override void OnInitialized()
    {
        _maxIconSizeBytes = long.Parse(
                _configuration.GetSection("DeviceTypeIconsConfig")["MaxIconSizeBytes"]
                ?? throw new ArgumentNullException("DeviceTypeIconsConfig:MaxIconSizeBytes not configured"));

        _previewIconUrl =_deviceTypeIconStorageService
            .BuildPublicUrl( _configuration.GetSection("DeviceTypeIconsConfig")["DefaultIconName"]
                ?? throw new ArgumentNullException("DeviceTypeIconsConfig:MaxIconSizeBytes not configured"), DateTime.Now);

        base.OnInitialized();
    }
    private async Task OnFileChanged(IBrowserFile? file)
    {
        _iconError = null;
        _submitError = null;

        if (file is null)
        {
            _model.IconFile = null;
            return;
        }

        var extension = Path.GetExtension(file.Name).ToLowerInvariant();
        if (!_deviceTypeIconStorageService.AllowedExtension.Contains(extension))
        {
            _iconError = "Only .svg, .png, .jpg, and .jpeg files are allowed.";
            _model.IconFile = null;
            return;
        }

        if (!_deviceTypeIconStorageService.AllowedContentTypes.Contains(file.ContentType))
        {
            _iconError = "File must be of type image/svg+xml.";
            _model.IconFile = null;
            return;
        }

        if (file.Size > _maxIconSizeBytes)
        {
            _iconError = $"File must be smaller than {_maxIconSizeBytes / 1024} KB.";
            _model.IconFile = null;
            return;
        }

        _model.IconFile = file;

        await using var stream = file.OpenReadStream(_maxIconSizeBytes);

        using var memoryStream = new MemoryStream();
        await stream.CopyToAsync(memoryStream);

        _previewIconUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(memoryStream.ToArray())}";
    }

    private async Task SubmitAsync()
    {
        _submitError = null;

        await _form.Validate();
        if (!_form.IsValid)
        {
            return;
        }

        if (await _deviceTypeService.DoesDeviceTypeExistByNameAsync(_model.Name))
        {
            _submitError = $"A device type named '{_model.Name}' already exists.";
            return;
        }

        _isSubmitting = true;

        try
        {
            await _deviceTypeService.CreateDeviceTypeAsync(_model, CancellationToken.None);
            _snackbar.Add($"Device type '{_model.Name}' created.", Severity.Success);
            MudDialog?.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            _submitError = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void Cancel()
    {
        MudDialog?.Cancel();
    }
}
