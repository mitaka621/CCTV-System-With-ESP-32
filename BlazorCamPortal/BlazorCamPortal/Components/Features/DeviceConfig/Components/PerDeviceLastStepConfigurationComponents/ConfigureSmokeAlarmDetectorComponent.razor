@using CamPortal.Contracts.Dtos.SecurityDtos
@using CamPortal.Contracts.Dtos.SmokeAlarmDetectorDtos
@inject ISmokeAlarmDetectorManagerService _smokeAlarmDetectorManagerService;
@inject ISmokeAlarmDetectorConfigurationService _smokeAlarmDetectorConfigurationService;
@inject ISmokeAlarmCommandDispatcher _smokeAlarmCommandDispatcher;
@inject IAdminAuthorizationGuard _adminAuthorizationGuard

<MudText Typo="Typo.h4" Class="mb-3">Configure device</MudText>

<MudGrid Spacing="4">
    <MudItem xs="12" md="5">
        <div class="smoke-alarm-panel">
            <MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="mb-3">
                Device Status
            </MudText>

            <div class="smoke-alarm-status" style="background-color: @GetStatusDisplayColor();">
                <div class="smoke-alarm-status-icon">
                    <MudIcon Icon="@Icons.Material.Filled.LocalFireDepartment" Style="font-size: 2.5rem;" />
                </div>
                <MudText Typo="Typo.h6" Class="smoke-alarm-status-text">@GetStatusDisplayDescription()</MudText>
                <MudTooltip Placement="Placement.Bottom">
                    <ChildContent>
                        <div class="smoke-alarm-last-report">
                            <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" />
                            <MudText Typo="Typo.caption">
                                Last report @MiscUtilities.TimeElapsedUntilNowInWords(_latestSmokeAlarmData.LoggedTimeUTC)
                            </MudText>
                        </div>
                    </ChildContent>
                    <TooltipContent>
                        <MudText Typo="Typo.body2">Last time when the smoke alarm detector sent telemetry to the server.</MudText>
                        <MudText Typo="Typo.body2">The detector does not stay on all the time. It wakes periodically</MudText>
                        <MudText Typo="Typo.body2">on a timer or by alarm trigger and only then it sends the telemetry data.</MudText>
                    </TooltipContent>
                </MudTooltip>
            </div>

            <div class="smoke-alarm-stats">
                <MudTooltip Placement="Placement.Top" Inline="false">
                    <ChildContent>
                        <div class="smoke-alarm-stat">
                            <MudIcon Icon="@GetBatteryIcon()" Color="Color.Primary" />
                            <div class="smoke-alarm-stat-text">
                                <MudText Typo="Typo.h6" Class="smoke-alarm-stat-value">@_latestSmokeAlarmData.BatterySOCPercent.ToString("0.#") %</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Battery</MudText>
                                <MudProgressLinear Value="@_latestSmokeAlarmData.BatterySOCPercent"
                                                   Color="@(IsBatteryLow() ? Color.Warning : Color.Success)"
                                                   Rounded="true"
                                                   Size="Size.Small"
                                                   Class="mt-1" />
                            </div>
                        </div>
                    </ChildContent>
                    <TooltipContent>
                        <MudText Typo="Typo.body2">Latest reported battery state of charge</MudText>
                    </TooltipContent>
                </MudTooltip>
                <MudTooltip Placement="Placement.Top" Inline="false">
                    <ChildContent>
                        <div class="smoke-alarm-stat">
                                <MudIcon Icon="@Icons.Material.Filled.Bolt" Color="Color.Primary" />
                                <div class="smoke-alarm-stat-text" >
                                    <MudText Typo="Typo.h6" Class="smoke-alarm-stat-value">@_latestSmokeAlarmData.BatteryVoltage.ToString("0.###") V</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Battery Voltage</MudText>
                                </div>
                         </div>
                    </ChildContent>
                    <TooltipContent>
                        <MudText Typo="Typo.body2">Latest reported battery voltage</MudText>
                    </TooltipContent>
                </MudTooltip>
                <MudTooltip Placement="Placement.Top" Inline="false">
                    <ChildContent>
                        <div class="smoke-alarm-stat">
                            <MudIcon Icon="@Icons.Material.Filled.ElectricalServices" Color="Color.Primary" />
                            <div class="smoke-alarm-stat-text">
                                <MudText Typo="Typo.h6" Class="smoke-alarm-stat-value">@_latestSmokeAlarmData.ChargingSenseVolts.ToString("0.###") V</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Charge Sense</MudText>
                            </div>
                        </div>
                    </ChildContent>
                    <TooltipContent>
                        <MudText Typo="Typo.body2">Latest reported voltage between the 5v pin and gnd pin of the esp32 s3.</MudText>
                        <MudText Typo="Typo.body2">When a charger is plugged, this voltage increases, allowing</MudText>
                        <MudText Typo="Typo.body2">the charging to be detected</MudText>
                    </TooltipContent>
                </MudTooltip>
                <MudTooltip Placement="Placement.Top" Inline="false">
                    <ChildContent>
                        <div class="smoke-alarm-stat">
                            <MudIcon Icon="@Icons.Material.Filled.RestartAlt" Color="Color.Primary" />
                            <div class="smoke-alarm-stat-text">
                                <MudText Typo="Typo.h6" Class="smoke-alarm-stat-value">@_latestSmokeAlarmData.BootCount</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Boot Count</MudText>
                            </div>
                        </div>
                    </ChildContent>
                    <TooltipContent>
                        <MudText Typo="Typo.body2">Number of times the smoke alarm detector (esp32 s3) </MudText>
                        <MudText Typo="Typo.body2">has gone to deep sleep and then started back up again </MudText>
                        <MudText Typo="Typo.body2">for reporting its current status</MudText>
                    </TooltipContent>
                </MudTooltip>
            </div>
        </div>
    </MudItem>

    <MudItem xs="12" md="7">
        <div class="smoke-alarm-panel">
            <MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="mb-3">
                Device Configuration
            </MudText>

            <MudStack Spacing="3">
                <MudTextField @bind-Value="_configurationModel.DeviceName"
                              @bind-Value:after="OnConfigurationChanged"
                              Immediate="true"
                              DebounceInterval="500"
                              Variant="Variant.Outlined"
                              For="()=>_configurationModel.DeviceName" />
                <MudTextField @bind-Value="_configurationModel.MinBatterySOCForAlert"
                              @bind-Value:after="OnConfigurationChanged"
                              Immediate="true"
                              DebounceInterval="500"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.End"
                              AdornmentText="%"
                              For="()=>_configurationModel.MinBatterySOCForAlert" />
                <MudTextField @bind-Value="_configurationModel.ChargeSenseVoltageThreashold"
                              @bind-Value:after="OnConfigurationChanged"
                              Immediate="true"
                              DebounceInterval="500"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.End"
                              AdornmentText="V"
                              HelperText="When this voltage threashold is exceeded, the smoke alarm will be marked as charging"
                              For="()=>_configurationModel.ChargeSenseVoltageThreashold" />
                <MudTextField @bind-Value="_configurationModel.MaxVoltageOverchargeWarning"
                              @bind-Value:after="OnConfigurationChanged"
                              Immediate="true"
                              DebounceInterval="500"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.End"
                              AdornmentText="V"
                              HelperText="If the onboard regulator fails, and the battery voltage exceeds this limit then a warning will be displayed"
                              For="()=>_configurationModel.MaxVoltageOverchargeWarning" />
            </MudStack>
        </div>
    </MudItem>
</MudGrid>

@code {
    private SmokeAlarmDetectorPayloadDto _latestSmokeAlarmData = new();
    private SmokeAlarmConfigurationModel _configurationModel = new();    

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    [Parameter, EditorRequired]
    public Guid SmokeAlarmId { get; set; } = default!;

    [Parameter, EditorRequired]
    public EventCallback ModelChanged { get; set; }

    [Parameter]
    public bool LoadExistingConfiguration { get; set; }


    protected override async Task OnInitializedAsync()
    {
        var configuration = await _smokeAlarmDetectorConfigurationService.GetSmokeAlarmConfigurationAsync(SmokeAlarmId);

        _configurationModel = configuration;


        var latestTelemetry = await _smokeAlarmDetectorManagerService.GetLatestTelemetryAsync(SmokeAlarmId);
        if (latestTelemetry != null)
        {
            _latestSmokeAlarmData = latestTelemetry;
        }

        _smokeAlarmDetectorManagerService.OnNewTelemetryAdded += OnNewSmokeAlarmData;

        await base.OnInitializedAsync();
    }

    private void OnNewSmokeAlarmData(SmokeAlarmDetectorPayloadDto data)
    {
        if (_configurationModel.DeviceId != data.DeviceId)
            return;

        _latestSmokeAlarmData = data;

        _ = InvokeAsync(StateHasChanged);
    }

    private string GetStatusDisplayColor() => _latestSmokeAlarmData.Event switch
    {
        SmokeAlarmEvent.FireAlarm => "var(--mud-palette-error)",
        SmokeAlarmEvent.AlarmLowBatteryChirp => "var(--mud-palette-warning)",
        SmokeAlarmEvent.BatteryCharging => "var(--mud-palette-primary)",
        SmokeAlarmEvent.BatteryWelfare => IsBatteryLow() ? "var(--mud-palette-warning)" : "var(--mud-palette-success)",
        _ => "var(--mud-palette-success)"
    };

    private string GetStatusDisplayDescription() => _latestSmokeAlarmData.Event switch
    {
        SmokeAlarmEvent.FireAlarm => "Smoke alarm is active!",
        SmokeAlarmEvent.AlarmLowBatteryChirp => "Change battery of the smoke alarm",
        SmokeAlarmEvent.BatteryCharging => "Smoke alarm detector is charging",
        SmokeAlarmEvent.BatteryWelfare => IsBatteryLow() ? "Smoke alarm detector needs charging" : "Smoke alarm not active",
        _ => "Smoke alarm not active"
    };

    private bool IsBatteryLow()
    {
        return _latestSmokeAlarmData.BatterySOCPercent < _configurationModel.MinBatterySOCForAlert;
    }

    private string GetBatteryIcon()
    {
        if (_latestSmokeAlarmData.IsCharging)
        {
            return Icons.Material.Filled.BatteryChargingFull;
        }

        return _latestSmokeAlarmData.BatterySOCPercent switch
        {
            >= 90 => Icons.Material.Filled.BatteryFull,
            >= 75 => Icons.Material.Filled.Battery6Bar,
            >= 60 => Icons.Material.Filled.Battery5Bar,
            >= 45 => Icons.Material.Filled.Battery4Bar,
            >= 30 => Icons.Material.Filled.Battery3Bar,
            >= 15 => Icons.Material.Filled.Battery2Bar,
            >= 5 => Icons.Material.Filled.Battery1Bar,
            _ => Icons.Material.Filled.Battery0Bar
        };
    }

    private async Task OnConfigurationChanged()
    {
        if (!await _adminAuthorizationGuard.TryAuthorizeAdminAsync())
        {
            return;
        }

        if(!await _smokeAlarmDetectorConfigurationService.UpdateConfigurationAsync(_configurationModel))
        {
            return;
        }

        _smokeAlarmCommandDispatcher.TryEnqueueConfig(SmokeAlarmId, new DeviceEspConfigDto()
        {
            ConfigurationPropertyName = nameof(SmokeAlarmAvailibleConfigsToEdit.ChargeSense),
            Value = _configurationModel.ChargeSenseVoltageThreashold
        });
    }
}
