@using CamPortal.Components.Features.DeviceConfig.Components.PerDeviceLastStepConfigurationComponents
@switch (model.PreprovisionRequest.DeviceCategory)
{
    case DeviceTypeCategories.Camera:
        <ConfigureCameraComponent CameraId="model.DeviceId ?? Guid.Empty" ModelChanged="StateHasChanged" />
        break;
    case DeviceTypeCategories.SmokeAlarm:
        <ConfigureSmokeAlarmDetectorComponent SmokeAlarmId="model.DeviceId ?? Guid.Empty" ModelChanged="StateHasChanged" />
        break;

    default:
        <MudText>Device Configuration component not implemented for this device type.</MudText>
        break;
}

@code{
    [Parameter, EditorRequired]
    public AddDeviceWizardStateModel model { get; set; } = default!;

    [Parameter, EditorRequired]
    public EventCallback ModelChanged { get; set; }
}