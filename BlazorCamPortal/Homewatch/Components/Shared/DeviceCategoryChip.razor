<MudChip T="string"
         Size="Size.Small"
         Color="@DeviceCategoryAppearance.GetColor(Category)"
         Icon="@DeviceCategoryAppearance.GetIcon(Category)"
         Class="@Class"
         Style="@Style">
    @MiscUtilities.GetDisplayNameAttributeValue(Category)
</MudChip>

@code {
    [Parameter, EditorRequired]
    public DeviceTypeCategories Category { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? Style { get; set; }
}
