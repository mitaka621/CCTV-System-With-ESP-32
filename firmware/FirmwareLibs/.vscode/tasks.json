{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Set up IntelliSense",
      "detail": "FirmwareLibs is compiled into the device projects, never on its own, so it has no database of its own. This builds NewDeviceExample's, which .clangd points at because that template links every library here.",
      "type": "process",
      "command": "${userHome}/.platformio/penv/bin/pio",
      "args": [
        "run",
        "-t",
        "compiledb"
      ],
      "windows": {
        "command": "${userHome}/.platformio/penv/Scripts/pio.exe"
      },
      "linux": {
        "command": "${userHome}/.platformio/penv/bin/pio"
      },
      "osx": {
        "command": "${userHome}/.platformio/penv/bin/pio"
      },
      "options": {
        "cwd": "${workspaceFolder}/../NewDeviceExample"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "close": true
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
