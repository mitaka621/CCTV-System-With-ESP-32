{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Set up IntelliSense: AutoVent",
      "detail": "Installs dependencies and writes compile_commands.json for AutoVent.",
      "type": "process",
      "command": "${userHome}/.platformio/penv/bin/pio",
      "args": [
        "run",
        "-t",
        "compiledb"
      ],
      "windows": {
        "command": "${userHome}/.platformio/penv/Scripts/pio.exe"
      },
      "linux": {
        "command": "${userHome}/.platformio/penv/bin/pio"
      },
      "osx": {
        "command": "${userHome}/.platformio/penv/bin/pio"
      },
      "options": {
        "cwd": "${workspaceFolder}/firmware/AutoVent"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "close": true
      }
    },
